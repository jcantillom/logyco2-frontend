# Plantilla de configuración del frontend. Copie a `.env` (ignorado por Git).
# Solo valores públicos: el frontend no debe contener secretos. En el pipeline se definen como variables de entorno
# y tienen prioridad sobre este archivo. `scripts/generate-env.mjs` los convierte en src/environments/environment.ts.

APP_ENV=development            # development | production
API_BASE_URL=http://127.0.0.1:8120   # origen del backend, sin ruta ni barra final; vacío solo en producción (mismo origen)
API_PREFIX=/api/v1             # prefijo de versión de la API
SESSION_PERSISTENCE=tab        # tab (solo desarrollo: token en sessionStorage) | memory (obligatorio en producción)
